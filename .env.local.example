# OANDA v20 API (practice account recommended to start)
OANDA_API_TOKEN=
OANDA_API_BASE_URL=https://api-fxpractice.oanda.com

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email alerts (Resend)
RESEND_API_KEY=
ALERT_EMAIL_TO=
# Optional: verified sender, defaults to Resend's onboarding sender
ALERT_EMAIL_FROM=
# Origin used for links in alert emails, e.g. https://tradebot.example.com
APP_BASE_URL=http://localhost:3000

# Shared secret checked as `Authorization: Bearer <CRON_SECRET>` on the
# /api/cron/* and /api/admin/* routes (Vercel Cron sends it automatically)
CRON_SECRET=
